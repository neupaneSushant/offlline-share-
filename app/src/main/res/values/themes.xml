<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theme; this exists so the window has sane
      colours during the moment between launch and first composition.
    -->
    <style name="Theme.OfflineShare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
